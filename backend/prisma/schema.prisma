generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  role         String   // "ADMIN" or "EMPLOYEE"
  name         String
  employeeId   String   @unique
  email        String   @unique
  passwordHash String
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  attendanceRecords AttendanceRecord[]
}

model AttendanceRecord {
  id               String   @id @default(uuid())
  userId           String
  date             String   // YYYY-MM-DD in Asia/Kathmandu
  checkInTime      DateTime?
  checkOutTime     DateTime?
  isManualCheckout Boolean  @default(false)
  status           String   // "PRESENT", "ABSENT", "HOLIDAY", "MISSED_CHECKOUT"
  sessionNumber    Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model Holiday {
  id        String   @id @default(uuid())
  date      String   @unique // YYYY-MM-DD
  name      String
  createdAt DateTime @default(now())
}

model Settings {
  id            String   @id @default(uuid())
  officeLat     Float    @default(27.7172) // Kathmandu roughly
  officeLng     Float    @default(85.3240)
  allowedRadius Int      @default(100) // meters
  qrCodePayload String   @default("officetrack-auth-123")
  updatedAt     DateTime @updatedAt
}
